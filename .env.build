# Placeholder values used only to satisfy Django's required settings during
# the `collectstatic` step of the Docker build (it never touches the
# database or serves requests). None of these are used at runtime - real
# config is supplied via the environment when the container runs.
DEBUG=False
SECRET_KEY=build-time-placeholder
DATABASE_URL=sqlite:////tmp/build.sqlite3
ASSET_TAG_PREFIX=BUILD
ASSET_TAG_DIGITS=1
ASSET_CATEGORY_CHOICES=Build
