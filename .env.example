DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# PostgreSQL - parsed by django-environ's env.db()
DATABASE_URL=postgres://pethau:password@localhost:5432/pethau

ASSET_TAG_PREFIX="AER"
ASSET_TAG_DIGITS=5
ASSET_CATEGORY_CHOICES=Storage,Supplies,Machine

# S3-compatible object storage for media (works with AWS S3, MinIO,
# DigitalOcean Spaces, Cloudflare R2, Backblaze B2, etc).
# Leave AWS_STORAGE_BUCKET_NAME blank to store media on local disk instead.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=https://s3.example.com
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=False
